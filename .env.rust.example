# Trisixt Rust runtime. Copy to .env for local development.
APP_ENV=development
HOST=0.0.0.0
PORT=3000
SERVER_HOST=localhost
DATABASE_URL=postgresql://trisixt:trisixt-dev-password@localhost:5432/trisixt
REDIS_URL=redis://:trisixt-dev-password@localhost:6379/0

# All implemented enterprise routes default on; false explicitly opts out.
TRISIXT_EE=true

# Analytics: clickhouse | bigquery
ANALYTICS_BACKEND=clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=trisixt
CLICKHOUSE_TABLE=events
CLICKHOUSE_USER=trisixt
CLICKHOUSE_PASSWORD=trisixt-dev-password
# ANALYTICS_BACKEND=bigquery
# GOOGLE_CLOUD_PROJECT=your-project-id
# PUBSUB_TOPIC=projects/your-project-id/topics/trisixt-events
# BIGQUERY_DATASET=trisixt
# BIGQUERY_TABLE=events
# BIGQUERY_LOCATION=US
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
# GOOGLE_ACCESS_TOKEN=short-lived-development-token

# Object storage: s3 | gcs
STORAGE_BACKEND=s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=trisixt
# Local S3-compatible MinIO. Remove AWS_ENDPOINT/AWS_ALLOW_HTTP for real AWS S3.
AWS_ENDPOINT=http://localhost:9000
# Container endpoint override for external S3-compatible storage:
# COMPOSE_AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_ALLOW_HTTP=true
AWS_ACCESS_KEY_ID=trisixt
AWS_SECRET_ACCESS_KEY=trisixt-dev-password
# STORAGE_BACKEND=gcs
# STORAGE_BUCKET=globally-unique-private-bucket
# GCS_CREDENTIALS=/absolute/path/to/service-account.json

# Compose development credentials. Change for non-local deployments.
POSTGRES_PASSWORD=trisixt-dev-password
REDIS_PASSWORD=trisixt-dev-password
# TRISIXT_IMAGE=your-registry/trisixt-backend:release-tag
# RUST_LOG=trisixt=info,tower_http=info

# Enterprise external providers: see docs/ENTERPRISE.md for profile schemas.
# OIDC_PROVIDERS_JSON='{"corporate":{"issuer":"https://id.example.com","client_id":"trisixt","client_secret_env":"OIDC_CLIENT_SECRET_CORPORATE","allowed_origins":[]}}'
# OIDC_REDIRECT_URL=https://api.example.com/auth/oidc/callback
# OIDC_CLIENT_SECRET_CORPORATE=inject-from-secret-store
# TRISIXT_IAP_PROFILES={}

# Account secret encryption (generate 32 random bytes, base64; keep persistent/backed up).
# TRISIXT_ENCRYPTION_KEY=
# ACCOUNT_FRONTEND_URL=https://app.example.com
# OTP_ISSUER=Trisixt
# DISABLE_REGISTRATION=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# MAILER_FROM=Trisixt <noreply@example.com>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# PUSH_PROFILES_JSON={}
# See docs/parity/ACCOUNTS_MESSAGING.md for FCM/APNs credential profiles.

# Custom-domain DNS/TLS: manual ownership proof or Cloudflare SaaS.
# CUSTOM_DOMAIN_MODE=manual
# DOMAIN_VERIFICATION_SECRET=inject-at-least-32-random-characters
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_SAAS_CNAME_TARGET=
# Import credentials are encrypted with a persistent 32-byte hex key.
# MIGRATION_ENCRYPTION_KEY=
# MCP issuer and dashboard consent screen.
# PUBLIC_URL=https://api.example.com
# MCP_CONSENT_URL=https://app.example.com/mcp/consent
# MCP_REGISTRATION_TOKEN=
# MCP_ALLOWED_REDIRECT_ORIGINS=https://app.example.com
# ADMIN_API_KEY=inject-from-secret-store

# Billing, store notification authentication, and trusted browser/proxy origins.
# TRISIXT_SELF_HOSTED=true
# FREE_MAU_COUNT=10000
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STANDARD_PRICE_ID=
# TRISIXT_DASHBOARD_URL=https://app.example.com
# TRISIXT_ADMIN_KEY=
# TRISIXT_PUBLIC_BASE_URL=https://api.example.com
# GOOGLE_PUBSUB_AUDIENCE=https://api.example.com
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# CORS_ALLOWED_ORIGINS=https://app.example.com
# TRUSTED_PROXY_IPS=
# SUPER_ADMIN_EMAILS=
# Mount provider credential files read-only into /run/secrets via a Compose override.
