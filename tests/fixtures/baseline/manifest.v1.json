  "run_contract": {
    "id_algorithm": "UUIDv8 from first 16 bytes of SHA256(UTF8(namespace + \"/\" + run_id + \"/\" + logical_key)); byte6=(byte6&15)|128, byte8=(byte8&63)|128",
    "run_id_pattern": "[a-z][a-z0-9-]{0,39}",
    "anchor": "Explicit UTC midnight on the previous day for a live run; persist it and reuse for replay. Reference example: 2026-09-18T00:00:00Z.",
    "query_from": "{{time:0}}",
    "query_to_exclusive": "{{time:86400}}",
    "secrets": "Generate owner tokens and SDK keys in the disposable harness only; neither tokens nor passwords belong in this manifest.",
    "generated_ids": "HTTP creation assigns owner/instance/project/campaign/link/device/purchase IDs; record response IDs in a runtime map. Deterministic IDs are suitable for isolated SQL seed fixtures and SDK event/visitor payloads."
  },
